#!/usr/bin/env -S usage bash
# Requires: usage CLI  https://github.com/jdx/usage
#   Install: mise use -g usage   |   cargo install usage-cli
# shellcheck shell=bash

#USAGE name "claude_switch"
#USAGE about "Switch the active Claude Code settings profile.\n\nUses ~/.claude/settings.json as a symlink pointing to the active profile.\nSettings live in the dotfriedrice repo under .config/claude/:\n  settings_personal.json          — tracked, no secrets\n  settings_bedrock.json.local     — gitignored; Amazon Bedrock via system-defined (global.*) inference profiles\n  settings_bedrock_app.json.local — gitignored; Amazon Bedrock via application inference profile ARNs (cost attribution)\n  settings_platform.json.local    — gitignored; Claude Platform on AWS (Anthropic-operated) creds + workspace id\n  settings_cloud.json.example     — tracked shared template; bootstraps the .local files\n  models.json                     — tracked model table shared by both bedrock modes"
#USAGE arg "[mode]" help="Profile to activate (default: status)" default="status" {
#USAGE   choices "personal" "bedrock" "bedrock-app" "platform" "status"
#USAGE }
#USAGE flag "--profile <profile>"          help_heading="AWS credentials" help="AWS SSO profile name (required for bedrock/bedrock-app/platform; updates .local if changed)"
#USAGE flag "--region <region>"            help_heading="AWS credentials" help="AWS region (required for bedrock/bedrock-app/platform; updates .local if changed)"
#USAGE flag "--wsl"                        help_heading="AWS credentials" help="Use --no-browser for AWS SSO login (WSL/headless; bedrock/bedrock-app/platform only)"
#USAGE flag "--workspace-id <workspace_id>" help_heading="Provider options" help="Claude Platform on AWS workspace id, wrkspc_… (required for platform only)"
#USAGE flag "--no-long-context"            help_heading="Provider options" help="Disable 1M context (1M is the default): bedrock modes use non-[1m] model variants, platform omits the context-1m anthropic-beta header"
#USAGE flag "--mantle" negate="--no-mantle" default=#false help_heading="Provider options" help="Route Mantle-format model IDs to the Mantle endpoint alongside the Invoke API (bedrock/bedrock-app; off by default — the Invoke API serves every model in models.json, and on bedrock-app a Mantle request would escape application-inference-profile attribution)"
#USAGE example "claude_switch personal"                                                                                           header="Switch to personal subscription"
#USAGE example "claude_switch bedrock --profile <aws_profile> --region us-west-2"                                                 header="Switch to Amazon Bedrock via global.* inference profiles (1M context by default)"
#USAGE example "claude_switch bedrock-app --profile <aws_profile> --region us-west-2"                                             header="Switch to Amazon Bedrock via application inference profile ARNs (cost attribution)"
#USAGE example "claude_switch bedrock-app --profile <aws_profile> --region us-west-2 --mantle"                                    header="Same, but keep the Mantle endpoint reachable alongside the Invoke API"
#USAGE example "claude_switch bedrock --profile <aws_profile> --region us-west-2 --wsl --no-long-context"                         header="Switch to Amazon Bedrock with WSL login and standard 200K context"
#USAGE example "claude_switch platform --profile <aws_profile> --region us-west-2 --workspace-id wrkspc_01ABCDEF"                 header="Switch to Claude Platform on AWS (1M context by default)"
#USAGE example "claude_switch status"                                                                                            header="Show current active profile"

# No comments inside the #USAGE block: usage stops collecting at the first
# non-#USAGE line and silently drops the rest.
#
# --mantle/--no-mantle is one negate= flag, so usage_mantle is always "true" or
# "false" and must be compared, not tested with -n. required_if= against a
# positional arg value is unenforced in usage 6.4.0, hence the manual checks below.

set -o errexit
set -o pipefail
set -o nounset

dotfriedrice_claude="${DOTFRIEDRICE_PATH:-${HOME}/src/github/dotfriedrice}/.config/claude"
target="${HOME}/.claude/settings.json"
personal="${dotfriedrice_claude}/settings_personal.json"
bedrock="${dotfriedrice_claude}/settings_bedrock.json.local"
bedrock_app="${dotfriedrice_claude}/settings_bedrock_app.json.local"
platform="${dotfriedrice_claude}/settings_platform.json.local"
cloud_example="${dotfriedrice_claude}/settings_cloud.json.example"
models_table="${dotfriedrice_claude}/models.json"

# Claude Code rewrites settings in its own schema key order, so generated files
# follow it to stay byte-stable across an in-app /model or /config change. Existing
# keys keep their position; this only places keys the script adds. Read out of the
# schema key table in the Claude Code binary (2.1.245).
# shellcheck disable=SC2016  # "$schema" is a JSON key, not a shell expansion
settings_key_order='[
  "$schema", "apiKeyHelper", "proxyAuthHelper", "awsCredentialExport",
  "awsAuthRefresh", "gcpAuthRefresh", "processWrapper", "env", "attribution",
  "includeCoAuthoredBy", "includeGitInstructions", "permissions", "model",
  "fallbackModel", "availableModels", "modelOverrides", "deniedMcpServers",
  "hooks", "disableAllHooks", "statusLine", "subagentStatusLine",
  "enabledPlugins", "extraKnownMarketplaces", "skipWebFetchPreflight",
  "sandbox", "feedbackSurveyRate", "promptCacheTtl", "subagentPromptCacheTtl",
  "alwaysThinkingEnabled", "effortLevel", "autoCompactWindow", "tui", "theme"
]'

# Opts out of every Anthropic-bound non-inference transmission, re-asserted each
# switch so it cannot be silently lost. Bedrock invocation logging is server-side
# and unaffected, so Athena cost reconciliation keeps working. Privacy invariants
# only; static settings live in settings_cloud.json.example.
#
# Cost: these also disable feature-flag fetching, losing artifacts, /loop
# self-pacing, cross-session messaging, /schedule, the advisor and the v2 MCP
# runtime. The template re-enables the last one.
# shellcheck disable=SC2016  # jq program text, no shell expansion intended
settings_privacy_jq='
  def privacy:
    # Any non-empty value opts out, so this is set, never toggled.
      .env.CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC = "1"
    | .env.DISABLE_TELEMETRY = "1"
    | .env.DISABLE_ERROR_REPORTING = "1"
    | .env.DISABLE_FEEDBACK_COMMAND = "1"
    | .env.CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY = "1"
    | .env.DO_NOT_TRACK = "1"
    # Without this the master switch leaves /fast reporting "currently unavailable".
    | .env.CLAUDE_CODE_SKIP_FAST_MODE_NETWORK_ERRORS = "1"
    # Not covered by the master switch. Drops the Anthropic blocklist.
    | .skipWebFetchPreflight = true
    | .feedbackSurveyRate = 0;
'

# Places added keys without moving existing ones: a new key lands just before the
# first key it outranks, or at the end if it outranks nothing present. Idempotent.
# shellcheck disable=SC2016  # "$ref" is a jq parameter, not a shell expansion
settings_reorder_jq='
  def _insert($ref; $k):
    ($ref | index($k)) as $rank
    | if $rank == null then . + [$k]
      else
        [ to_entries[]
          | select(.value as $existing
                   | ($ref | index($existing)) as $r
                   | $r != null and $r > $rank)
          | .key ] as $after
        | ( if ($after | length) == 0 then length else ($after | min) end ) as $at
        | .[0:$at] + [$k] + .[$at:]
      end;

  # $prior is the entry order; those keys keep their positions.
  def reorder($ref; $prior):
    . as $obj
    | ($obj | keys_unsorted) as $have
    | ($prior | map(select(IN($have[])))) as $kept
    | reduce ($have | map(select(IN($prior[]) | not)))[] as $k
        ($kept; _insert($ref; $k))
    | reduce .[] as $k ({}; .[$k] = $obj[$k]);
'

mode="${usage_mode:-status}"
aws_profile="${usage_profile:-}"
aws_region="${usage_region:-}"
workspace_id="${usage_workspace_id:-}"
use_wsl="${usage_wsl:-}"
use_no_long_context="${usage_no_long_context:-}"
use_mantle="${usage_mantle:-false}"

# 1M context is the default; --no-long-context opts down to standard 200K.
if [[ -n "${use_no_long_context}" ]]; then
  long_context="false"
else
  long_context="true"
fi

_status() {
  if [[ -L "${target}" ]]; then
    real="$(readlink "${target}")"
    case "${real}" in
    *personal*) echo "current: personal" ;;
    # Must precede the *bedrock* arm: the app filename also contains "bedrock".
    *bedrock_app*)
      local aws_prof auth_refresh opus_model opus_name tags
      aws_prof="$(jq -r '.env.AWS_PROFILE // ""' "${real}" 2>/dev/null)"
      auth_refresh="$(jq -r '.awsAuthRefresh // ""' "${real}" 2>/dev/null)"
      opus_model="$(jq -r '.env.ANTHROPIC_DEFAULT_OPUS_MODEL // ""' "${real}" 2>/dev/null)"
      opus_name="$(jq -r '.env.ANTHROPIC_DEFAULT_OPUS_MODEL_NAME // ""' "${real}" 2>/dev/null)"
      tags=""
      [[ "${auth_refresh}" == *"--no-browser"* ]] && tags+=" [wsl]"
      [[ "${opus_model}" == *"[1m]"* ]] && tags+=" [1m]"
      [[ "$(jq -r '.env.CLAUDE_CODE_USE_MANTLE // ""' "${real}" 2>/dev/null)" == "1" ]] && tags+=" [mantle]"
      [[ -n "${opus_name}" ]] && tags+=" ${opus_name}"
      if [[ -n "${aws_prof}" ]]; then
        printf 'current: bedrock-app (%s)%s\n' "${aws_prof}" "${tags}"
      else
        printf 'current: bedrock-app%s\n' "${tags}"
      fi
      ;;
    *bedrock*)
      local aws_prof auth_refresh opus_model tags
      aws_prof="$(jq -r '.env.AWS_PROFILE // ""' "${real}" 2>/dev/null)"
      auth_refresh="$(jq -r '.awsAuthRefresh // ""' "${real}" 2>/dev/null)"
      opus_model="$(jq -r '.env.ANTHROPIC_DEFAULT_OPUS_MODEL // ""' "${real}" 2>/dev/null)"
      tags=""
      [[ "${auth_refresh}" == *"--no-browser"* ]] && tags+=" [wsl]"
      [[ "${opus_model}" == *"[1m]"* ]] && tags+=" [1m]"
      # Mantle is opt-in in this mode too, so it is worth surfacing when on.
      [[ "$(jq -r '.env.CLAUDE_CODE_USE_MANTLE // ""' "${real}" 2>/dev/null)" == "1" ]] && tags+=" [mantle]"
      if [[ -n "${aws_prof}" ]]; then
        printf 'current: bedrock (%s)%s\n' "${aws_prof}" "${tags}"
      else
        printf 'current: bedrock%s\n' "${tags}"
      fi
      ;;
    *platform*)
      local aws_prof auth_refresh betas tags
      aws_prof="$(jq -r '.env.AWS_PROFILE // ""' "${real}" 2>/dev/null)"
      auth_refresh="$(jq -r '.awsAuthRefresh // ""' "${real}" 2>/dev/null)"
      betas="$(jq -r '.env.ANTHROPIC_BETAS // ""' "${real}" 2>/dev/null)"
      tags=""
      [[ "${auth_refresh}" == *"--no-browser"* ]] && tags+=" [wsl]"
      [[ "${betas}" == *"context-1m"* ]] && tags+=" [1m]"
      if [[ -n "${aws_prof}" ]]; then
        printf 'current: platform (%s)%s\n' "${aws_prof}" "${tags}"
      else
        printf 'current: platform%s\n' "${tags}"
      fi
      ;;
    *) echo "current: unknown → ${real}" ;;
    esac
  elif [[ ! -e "${target}" ]]; then
    printf 'No active profile: %s does not exist\nRun: claude_switch bedrock|bedrock-app|personal\n' "${target}" >&2
  else
    printf 'No active profile: %s is not a symlink\nRun: claude_switch bedrock|bedrock-app|personal\n' "${target}" >&2
  fi
}

_bootstrap() {
  local file="${1}"
  if [[ ! -f "${file}" ]]; then
    if [[ ! -f "${cloud_example}" ]]; then
      printf 'Error: example file not found: %s\n' "${cloud_example}" >&2
      exit 1
    fi
    cp "${cloud_example}" "${file}"
    printf 'Bootstrapped %s from example\n' "${file}"
  fi
}

# ACTIVE application inference profiles keyed by backing foundation-model ID, the
# join key in models.json, so a profile rename in Terraform is harmless:
#   { "anthropic.claude-opus-5": { "name": "map-opus-5", "arn": "arn:…" }, … }
# Prints "{}" and warns when AWS is unreachable, so expired SSO never blocks a switch.
_discover_app_profiles() {
  local profile="${1}" region="${2}" out
  if ! out="$(aws bedrock list-inference-profiles \
    --type-equals APPLICATION \
    --profile "${profile}" \
    --region "${region}" \
    --output json 2>/dev/null)"; then
    printf 'Warning: could not list application inference profiles (profile %s, region %s).\n' \
      "${profile}" "${region}" >&2
    printf '         Leaving the existing model configuration untouched. Log in with aws sso and retry: aws sso login --profile %s\n' \
      "${profile}" >&2
    echo '{}'
    return 0
  fi
  jq -c '[ .inferenceProfileSummaries[]
           | select(.status == "ACTIVE")
           | { key:   (.models[0].modelArn | split("/") | last),
               value: { name: .inferenceProfileName, arn: .inferenceProfileArn } } ]
         | from_entries' <<<"${out}"
}

# Shared by both bedrock modes so they cannot drift. Only the mapped value differs:
# a global.* profile ID for `bedrock`, an application profile ARN for `bedrock-app`.
_update_bedrock_credentials() {
  local file="${1}" profile="${2}" region="${3}" wsl="${4}" lctx="${5}"
  local mode="${6}" arn_json="${7}" mantle="${8}"

  local current_profile current_region current_auth_refresh
  current_profile="$(jq -r '.env.AWS_PROFILE // ""' "${file}")"
  current_region="$(jq -r '.env.AWS_REGION // ""' "${file}")"
  current_auth_refresh="$(jq -r '.awsAuthRefresh // ""' "${file}")"

  local effective_profile="${profile:-${current_profile}}"
  local effective_region="${region:-${current_region}}"

  local desired_auth_refresh
  if [[ "${wsl}" == "true" ]]; then
    desired_auth_refresh="aws sso login --no-browser --profile ${effective_profile}"
  else
    desired_auth_refresh="aws sso login --profile ${effective_profile}"
  fi

  # Failed discovery yields {}: apply credentials and routing, keep the model config.
  local apply_models="true"
  if [[ "${mode}" == "bedrock-app" && "${arn_json}" == "{}" ]]; then
    apply_models="false"
    printf 'Keeping existing model config: no application inference profiles resolved\n' >&2
  fi

  local tmp
  tmp="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '${tmp}'" RETURN

  jq --slurpfile table "${models_table}" \
    --argjson arns "${arn_json}" \
    --arg mode "${mode}" \
    --argjson lctx "${lctx}" \
    --argjson mantle "${mantle}" \
    --argjson applyModels "${apply_models}" \
    --argjson keyOrder "${settings_key_order}" \
    --arg p "${effective_profile}" \
    --arg r "${effective_region}" \
    --arg auth "${desired_auth_refresh}" "${settings_privacy_jq}${settings_reorder_jq}"'
    # The order Claude Code last wrote.
    (keys_unsorted) as $prior
    | ($table[0].models) as $all
    | ( if $mode == "bedrock-app"
        then [ $all[]
               | select(.foundationModel != null and $arns[.foundationModel] != null)
               | . + { value:   $arns[.foundationModel].arn,
                       profile: $arns[.foundationModel].name } ]
        else [ $all[]
               | select(.bedrock != null)
               | . + { value: .bedrock, profile: "" } ]
        end
      ) as $sel
    | ( $sel | sort_by(.family, .rank) ) as $sorted
    | ( $sorted | group_by(.family) | map(min_by(.rank)) ) as $winners
    | ( $sorted | map(select(.family == "opus")) ) as $opus
    | ( $winners | map(select(.family == "sonnet")) ) as $sonnet
    | ( $sel | map({ key: .id, value: .value }) | from_entries ) as $overrides
    | [ ($opus[1].id // empty), ($sonnet[0].id // empty) ] as $fallback

    # --- credentials ---
    | .env.AWS_PROFILE = $p
    | .env.AWS_REGION = $r
    | .env.AWS_DEFAULT_REGION = $r
    | .awsAuthRefresh = $auth

    # --- provider routing ---
    # del() enforces mode shape: the provider shapes are mutually exclusive.
    | .env.CLAUDE_CODE_USE_BEDROCK = "1"
    | if $mantle then .env.CLAUDE_CODE_USE_MANTLE = "1"
                 else del(.env.CLAUDE_CODE_USE_MANTLE) end
    | del(.env.CLAUDE_CODE_USE_ANTHROPIC_AWS,
          .env.ANTHROPIC_AWS_WORKSPACE_ID,
          .env.ANTHROPIC_BETAS)

    # --- models ---
    | if $applyModels then
        # Cleared first so a dropped family cannot survive a switch.
        (.env |= with_entries(select(.key | startswith("ANTHROPIC_DEFAULT_") | not)))
        | reduce $winners[] as $w (.;
            ("ANTHROPIC_DEFAULT_" + ($w.family | ascii_upcase) + "_MODEL") as $k
            | .env[$k] = ($w.value + (if ($lctx and $w.longContext) then "[1m]" else "" end))
            # Without this the picker row shows the raw provider ID.
            | .env[$k + "_NAME"] = (if $mode == "bedrock-app"
                                    then $w.id + " (" + $w.profile + ")"
                                    else $w.id end)
            | .env[$k + "_DESCRIPTION"] = (if $mode == "bedrock-app"
                                           then "Bedrock application inference profile " + $w.profile
                                           else "Bedrock system-defined inference profile " + $w.value end)
            # bedrock-app only: this REPLACES built-in detection, which cannot read
            # an opaque profile ARN. A global.anthropic.claude-* ID it can.
            | if $mode == "bedrock-app"
              then .env[$k + "_SUPPORTED_CAPABILITIES"] = $w.capabilities
              else . end
          )
        | (if ($overrides | length) > 0 then .modelOverrides = $overrides
                                        else del(.modelOverrides) end)
        # Anthropic IDs, so they resolve through modelOverrides and stay attributed.
        | (if ($fallback | length) > 0 then .fallbackModel = $fallback
                                       else del(.fallbackModel) end)
      else . end
    # Without both, jq would append new keys wherever the last write left off.
    | privacy
    | .env |= (to_entries | sort_by(.key) | from_entries)
    | reorder($keyOrder; $prior)
  ' "${file}" >"${tmp}"

  if cmp -s "${tmp}" "${file}"; then
    printf 'Settings already up to date in %s\n' "${file}"
    return 0
  fi
  mv "${tmp}" "${file}"

  [[ "${current_profile}" != "${effective_profile}" ]] &&
    printf 'Updated AWS_PROFILE       → %s\n' "${effective_profile}"
  [[ "${current_region}" != "${effective_region}" ]] &&
    printf 'Updated AWS_REGION        → %s\n' "${effective_region}"
  if [[ "${current_auth_refresh}" != "${desired_auth_refresh}" ]]; then
    if [[ "${wsl}" == "true" ]]; then
      printf 'Updated awsAuthRefresh    → headless (--no-browser)\n'
    else
      printf 'Updated awsAuthRefresh    → standard\n'
    fi
  fi

  if [[ "${apply_models}" == "true" ]]; then
    local ctx_note="200K context"
    [[ "${lctx}" == "true" ]] && ctx_note="1M context where supported"
    printf 'Updated models            → %s versions via modelOverrides, %s\n' \
      "$(jq -r '.modelOverrides // {} | length' "${file}")" "${ctx_note}"
    jq -r '.env
         | to_entries
         | map(select(.key | test("^ANTHROPIC_DEFAULT_[A-Z]+_MODEL$")))
         | .[]
         | "  " + (.key | ltrimstr("ANTHROPIC_DEFAULT_") | rtrimstr("_MODEL") | ascii_downcase)
                + " → " + .value' "${file}"
  fi
  printf 'Settings updated in %s\n' "${file}"
  return 0
}

# Reports drift both ways: a model in only one of Terraform or models.json.
_report_model_coverage() {
  local arn_json="${1}"
  [[ "${arn_json}" == "{}" ]] && return 0

  local missing extra
  missing="$(jq -r --argjson arns "${arn_json}" '
    [ .models[] | select($arns[.foundationModel] == null) | .id ] | join(", ")
  ' "${models_table}")"
  extra="$(jq -r --slurpfile table "${models_table}" '
    [ to_entries[]
      | select(.key as $fm | ($table[0].models | map(.foundationModel) | index($fm)) == null)
      | .value.name ] | join(", ")
  ' <<<"${arn_json}")"

  [[ -n "${missing}" ]] &&
    printf 'Note: no application inference profile for: %s (add one in Terraform to route it)\n' "${missing}"
  [[ -n "${extra}" ]] &&
    printf 'Note: application profiles with no models.json row: %s (add a row to expose them)\n' "${extra}"
  return 0
}

# Claude Platform on AWS shape. Anthropic operates the stack and AWS only supplies
# SigV4 auth plus the workspace id, so Bedrock/Mantle routing flags must be absent
# and model IDs are plain Claude API IDs.
#
# The context-1m beta is likely redundant here, since the pinned models already run
# at 1M on the Anthropic API. Kept because an unneeded beta value is harmless.
_update_platform_credentials() {
  local file="${1}" profile="${2}" region="${3}" wsl="${4}" long_context="${5}" wid="${6}"

  local current_profile current_region current_auth_refresh current_wid current_betas
  current_profile="$(jq -r '.env.AWS_PROFILE // ""' "${file}")"
  current_region="$(jq -r '.env.AWS_REGION // ""' "${file}")"
  current_auth_refresh="$(jq -r '.awsAuthRefresh // ""' "${file}")"
  current_wid="$(jq -r '.env.ANTHROPIC_AWS_WORKSPACE_ID // ""' "${file}")"
  current_betas="$(jq -r '.env.ANTHROPIC_BETAS // ""' "${file}")"

  local desired_auth_refresh
  if [[ "${wsl}" == "true" ]]; then
    desired_auth_refresh="aws sso login --no-browser --profile ${profile}"
  else
    desired_auth_refresh="aws sso login --profile ${profile}"
  fi

  local desired_betas=""
  [[ "${long_context}" == "true" ]] && desired_betas="context-1m-2025-08-07"

  local tmp
  tmp="$(mktemp)"
  # shellcheck disable=SC2064
  trap "rm -f '${tmp}'" RETURN

  jq --arg p "${profile}" \
    --arg r "${region}" \
    --arg w "${wid}" \
    --arg auth "${desired_auth_refresh}" \
    --argjson keyOrder "${settings_key_order}" \
    --arg betas "${desired_betas}" "${settings_privacy_jq}${settings_reorder_jq}"'
    (keys_unsorted) as $prior
    | .env.AWS_PROFILE = $p
    | .env.AWS_REGION = $r
    | .env.AWS_DEFAULT_REGION = $r
    | .awsAuthRefresh = $auth
    | .env.CLAUDE_CODE_USE_ANTHROPIC_AWS = "1"
    | .env.ANTHROPIC_AWS_WORKSPACE_ID = $w
    | .env |= with_entries(select(.key | startswith("ANTHROPIC_DEFAULT_") | not))
    | .env.ANTHROPIC_DEFAULT_OPUS_MODEL   = "claude-opus-5"
    | .env.ANTHROPIC_DEFAULT_SONNET_MODEL = "claude-sonnet-5"
    | .env.ANTHROPIC_DEFAULT_HAIKU_MODEL  = "claude-haiku-4-5"
    | .env.ANTHROPIC_DEFAULT_FABLE_MODEL  = "claude-fable-5"
    # The body idle timeout is inactive here and the byte watchdog needs no opt-in.
    | del(.modelOverrides,
          .fallbackModel,
          .env.CLAUDE_CODE_USE_BEDROCK,
          .env.CLAUDE_CODE_USE_MANTLE,
          .env.ANTHROPIC_BEDROCK_SERVICE_TIER,
          .env.API_FORCE_IDLE_TIMEOUT,
          .env.CLAUDE_ENABLE_BYTE_WATCHDOG_BEDROCK)
    | if $betas == "" then del(.env.ANTHROPIC_BETAS) else .env.ANTHROPIC_BETAS = $betas end
    | privacy
    | .env |= (to_entries | sort_by(.key) | from_entries)
    | reorder($keyOrder; $prior)
  ' "${file}" >"${tmp}"

  if cmp -s "${tmp}" "${file}"; then
    return 0
  fi
  mv "${tmp}" "${file}"

  [[ "${current_profile}" != "${profile}" ]] && printf 'Updated AWS_PROFILE               → %s\n' "${profile}"
  [[ "${current_region}" != "${region}" ]] && printf 'Updated AWS_REGION                → %s\n' "${region}"
  [[ "${current_wid}" != "${wid}" ]] && printf 'Updated ANTHROPIC_AWS_WORKSPACE_ID → %s\n' "${wid}"
  if [[ "${current_auth_refresh}" != "${desired_auth_refresh}" ]]; then
    if [[ "${wsl}" == "true" ]]; then
      printf 'Updated awsAuthRefresh            → headless (--no-browser)\n'
    else
      printf 'Updated awsAuthRefresh            → standard\n'
    fi
  fi
  if [[ "${current_betas}" != "${desired_betas}" ]]; then
    if [[ "${long_context}" == "true" ]]; then
      printf 'Updated context window           → 1M (anthropic-beta context-1m-2025-08-07)\n'
    else
      printf 'Updated context window           → standard (200K)\n'
    fi
  fi
  printf 'Settings updated in %s\n' "${file}"
}

if [[ -n "${use_wsl}" || -n "${use_no_long_context}" ]] &&
  [[ "${mode}" != "bedrock" && "${mode}" != "bedrock-app" && "${mode}" != "platform" ]]; then
  printf 'Error: --wsl and --no-long-context are only supported for bedrock, bedrock-app and platform modes\n' >&2
  exit 1
fi

# Only --mantle is gated: an explicit --no-mantle equals the default.
if [[ "${use_mantle}" == "true" ]] &&
  [[ "${mode}" != "bedrock" && "${mode}" != "bedrock-app" ]]; then
  printf 'Error: --mantle is only supported for bedrock and bedrock-app modes\n' >&2
  exit 1
fi

if [[ -n "${workspace_id}" && "${mode}" != "platform" ]]; then
  printf 'Error: --workspace-id is only supported for platform mode\n' >&2
  exit 1
fi

if [[ "${mode}" == "bedrock" || "${mode}" == "bedrock-app" || "${mode}" == "platform" ]]; then
  [[ -n "${aws_profile}" ]] || {
    printf 'Error: --profile is required when switching to %s\n' "${mode}" >&2
    exit 1
  }
  [[ -n "${aws_region}" ]] || {
    printf 'Error: --region is required when switching to %s\n' "${mode}" >&2
    exit 1
  }
fi

if [[ "${mode}" == "bedrock" || "${mode}" == "bedrock-app" ]]; then
  [[ -f "${models_table}" ]] || {
    printf 'Error: model table not found: %s\n' "${models_table}" >&2
    exit 1
  }
fi

if [[ "${mode}" == "platform" ]]; then
  [[ -n "${workspace_id}" ]] || {
    printf 'Error: --workspace-id is required when switching to platform\n' >&2
    exit 1
  }
fi

case "${mode}" in
personal)
  [[ -f "${personal}" ]] || {
    printf 'Error: %s not found\n' "${personal}" >&2
    exit 1
  }
  ln -fns "${personal}" "${target}"
  printf 'Switched to personal config\n'
  ;;
bedrock)
  _bootstrap "${bedrock}"
  # Off by default: the Invoke API serves every model in models.json. The flag alone
  # routes nothing, since Mantle needs Mantle-format IDs (anthropic.claude-sonnet-5).
  _update_bedrock_credentials "${bedrock}" "${aws_profile}" "${aws_region}" \
    "${use_wsl:-false}" "${long_context}" "bedrock" "{}" "${use_mantle}"
  ln -fns "${bedrock}" "${target}"
  printf 'Switched to bedrock config (system-defined inference profiles)\n'
  ;;
bedrock-app)
  _bootstrap "${bedrock_app}"
  app_profiles="$(_discover_app_profiles "${aws_profile}" "${aws_region}")"
  # Also off: a Mantle request would escape application-profile attribution.
  _update_bedrock_credentials "${bedrock_app}" "${aws_profile}" "${aws_region}" \
    "${use_wsl:-false}" "${long_context}" "bedrock-app" "${app_profiles}" "${use_mantle}"
  _report_model_coverage "${app_profiles}"
  ln -fns "${bedrock_app}" "${target}"
  printf 'Switched to bedrock-app config (application inference profiles)\n'
  printf 'Reminder: invoking these ARNs needs bedrock:InvokeModel* on\n'
  printf '          arn:aws:bedrock:*:<account>:application-inference-profile/*\n'
  printf '          — the AWSBedrock{,Opus}UserAccessPolicy permission sets only\n'
  printf '          allow inference-profile/*anthropic*, which does not match.\n'
  ;;
platform)
  _bootstrap "${platform}"
  _update_platform_credentials "${platform}" "${aws_profile}" "${aws_region}" \
    "${use_wsl:-false}" "${long_context}" "${workspace_id}"
  ln -fns "${platform}" "${target}"
  printf 'Switched to Claude Platform on AWS config\n'
  ;;
status)
  _status
  ;;
*)
  # Unreachable unless a #USAGE choice is added without an arm here.
  printf 'Error: unhandled mode: %s\n' "${mode}" >&2
  exit 1
  ;;
esac
