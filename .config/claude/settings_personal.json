{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "API_TIMEOUT_MS": "1800000",
    "BASH_DEFAULT_TIMEOUT_MS": "300000",
    "BASH_MAX_OUTPUT_LENGTH": "50000",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "CLAUDE_CODE_SKIP_FAST_MODE_NETWORK_ERRORS": "1",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "600000",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "DISABLE_TELEMETRY": "1",
    "DISABLE_UPDATES": "1",
    "DO_NOT_TRACK": "1",
    "FORCE_AUTOUPDATE_PLUGINS": "1",
    "MCP_PROTOCOL_NEGOTIATION": "auto",
    "MCP_SDK_GENERATION": "v2"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "~/.claude/subagent-statusline.sh"
  },
  "enabledPlugins": {
    "claude-md-management@claude-plugins-official": true,
    "document-skills@anthropic-agent-skills": true,
    "frontend-design@claude-plugins-official": true,
    "aws-core@claude-plugins-official": true,
    "aws-data-analytics@claude-plugins-official": true
  },
  "enabledMcpjsonServers": [
    "terraform"
  ],
  "deniedMcpServers": [
    {
      "serverName": "plugin:aws-core:aws-mcp"
    },
    {
      "serverName": "plugin:aws-data-analytics:aws-mcp"
    },
    {
      "serverCommand": [
        "uvx",
        "mcp-proxy-for-aws@1.6.3",
        "https://aws-mcp.us-east-1.api.aws/mcp",
        "--skip-auth",
        "--metadata",
        "INSTALL_SOURCE=agent-toolkit"
      ]
    }
  ],
  "extraKnownMarketplaces": {
    "anthropic-agent-skills": {
      "source": {
        "source": "github",
        "repo": "anthropics/skills"
      },
      "autoUpdate": true
    }
  },
  "skipWebFetchPreflight": true,
  "feedbackSurveyRate": 0,
  "effortLevel": "high",
  "tui": "fullscreen",
  "theme": "auto"
}
